# Copy this file to .env.test.local (gitignored) and fill in the real
# credentials for your local postgres container. test/setup.ts reads ONLY
# .env.test.local for DATABASE_URL/DIRECT_URL - it never reads the
# project's real .env, on purpose, so tests can't accidentally run against
# your dev database.
#
# Point at a separate `ceoms_test` database on the same local instance:
#   docker exec ceoms-postgres psql -U $POSTGRES_USER -d postgres \
#     -c "CREATE DATABASE ceoms_test OWNER $POSTGRES_USER;"
#
# Values here are illustrative, not real credentials.
DATABASE_URL=postgresql://ceoms:changeme@localhost:5434/ceoms_test
DIRECT_URL=postgresql://ceoms:changeme@localhost:5434/ceoms_test
