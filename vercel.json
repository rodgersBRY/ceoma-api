{
  "builds": [{ "src": "api/index.ts", "use": "@vercel/node" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    {
      "path": "/api/v1/cron/contract-risk-alerts",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/v1/cron/api-key-expiry-alerts",
      "schedule": "15 7 * * *"
    }
  ]
}
